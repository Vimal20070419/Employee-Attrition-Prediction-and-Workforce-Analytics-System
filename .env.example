# ============================================================
# APPLICATION
# ============================================================
APP_NAME=AttritionPlatform
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=attrition_db
POSTGRES_USER=attrition_user
POSTGRES_PASSWORD=attrition_password_change_me
DATABASE_URL=postgresql://attrition_user:attrition_password_change_me@postgres:5432/attrition_db

# ============================================================
# REDIS (Cache + Celery Broker)
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ============================================================
# BACKEND
# ============================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_PREFIX=/api/v1

# ============================================================
# ML SERVICE
# ============================================================
ML_SERVICE_HOST=ml_service
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://ml_service:8001
MODEL_ARTIFACTS_PATH=/app/artifacts/models
SHAP_ARTIFACTS_PATH=/app/artifacts/shap
PLOTS_PATH=/app/artifacts/plots
MAX_TRAINING_JOBS=3

# ============================================================
# EMAIL (SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@attritionplatform.com
SMTP_FROM_NAME=Attrition Platform
EMAIL_ENABLED=false

# ============================================================
# CELERY
# ============================================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Kolkata

# ============================================================
# FILE UPLOAD
# ============================================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=csv,xlsx,xls

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_PERIOD_SECONDS=60

# ============================================================
# FRONTEND
# ============================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ML_SERVICE_URL=http://localhost:8001
VITE_APP_NAME=AttritionIQ

# ============================================================
# CLOUD DEPLOYMENT
# ============================================================
RENDER_SERVICE_URL=https://your-app.onrender.com
RAILWAY_SERVICE_URL=https://your-app.railway.app

# ============================================================
# MONITORING
# ============================================================
CELERY_FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:flower_password_change_me
